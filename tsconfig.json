{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // scripts/ runs under `node --experimental-strip-types`, which needs the
    // `.ts` extension on relative imports.
    "allowImportingTsExtensions": true,
    // Tests only: the validator rejects anything but relative imports in
    // runtime code, so files outside src/__tests__/ keep using './'.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "scripts", "vitest.config.ts"]
}
